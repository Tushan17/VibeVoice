{
  "name": "vibevoice-desktop",
  "version": "1.0.0",
  "description": "VibeVoice Desktop — AI Text-to-Speech and Speech-to-Text",
  "main": "main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "electron": "electron .",
    "build": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:linux": "npm run build:renderer && electron-builder --linux"
  },
  "dependencies": {
    "@heroui/react": "^3.0.0",
    "@heroui/styles": "^3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "com.microsoft.vibevoice.desktop",
    "productName": "VibeVoice Desktop",
    "copyright": "Copyright © 2025 Microsoft",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "server/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
